<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.program.photololitas" name="Photo Lolitas" version="2.0.0" provider-name="JoaoSagrath">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
	<!-- melhora o tempo de inicialização -->
    <reuselanguageinvoker>true</reuselanguageinvoker>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
		
		<language>resource.language.en_gb</language>
		<language>resource.language.pt_br</language>
        
			<summary lang="en_GB">A simple Kodi addon</summary>
			<summary lang="pt_BR">Um addon simples para Kodi</summary>
	        <description lang="en_GB">This is a sample addon for Kodi Matrix</description>
	        <description lang="pt_BR">Este é um addon de exemplo para Kodi Matrix</description>
        <platform>all</platform>
        <assets>
            <icon>media/icon.png</icon>
            <fanart>media/fanart.jpg</fanart>
            <screenshot></screenshot>
            <screenshot></screenshot>
            <screenshot></screenshot>
        </assets>
    </extension>
</addon>
